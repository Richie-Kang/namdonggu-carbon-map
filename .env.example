# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # local ETL only — NEVER ship to browser
SUPABASE_DB_URL=                    # postgres://... for psql/psycopg

# ---------- External APIs ----------
# SGIS keys are OPTIONAL since ADR-0019 — KOSIS 다사 100m grid is loaded
# from local ZIP under data/9_인구밀도/ via etl/04_load_population_grid.py.
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
KAKAO_REST_API_KEY=                 # optional, geocoding (factories)
VWORLD_API_KEY=                     # optional, geocoding fallback

# ---------- Observability ----------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=                  # server only, for source map upload
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Map ----------
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_PMTILES_URL=            # Supabase Storage public URL or /public path

# ---------- Misc ----------
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_LANG=ko
