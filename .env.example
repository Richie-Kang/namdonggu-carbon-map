SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
KAKAO_REST_API_KEY=                 # optional, geocoding (factories)
VWORLD_API_KEY=                     # optional, geocoding fallback
RUNYOUR_API_KEY=runyour-v1-578bbeeb-9bf2-4714-a2e4-fa54e70b7803-duUUymR1dZ-bRV7Tw1kljPRli2CaBswXO0s3fjLy6Im2VpkP1oSNMahAbSo2T8IU                    # server only, RunYourAI API router key
RUNYOUR_API_BASE_URL=https://api.runyour.ai/v1
